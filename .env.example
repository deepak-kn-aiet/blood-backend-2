# Application Settings
PROJECT_NAME="Blood Relay API"
VERSION="0.1.0"
DEBUG=True

# Database Settings (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blood_relay_db

# Full SQLAlchemy Database URL options:
# 1. Local macOS Homebrew PostgreSQL:
DATABASE_URL=postgresql://localhost:5432/blood_relay_db
# 2. Production / Docker PostgreSQL with credentials:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_relay_db

# Authentication / Security
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

